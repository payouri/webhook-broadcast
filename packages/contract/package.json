{
  "name": "@webhook-broadcast/contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./endpoint-url": "./src/endpointUrl.ts",
    "./client": "./src/generated/admin-client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "emit:openapi": "tsx scripts/emit-admin-openapi.ts",
    "check:openapi": "tsx scripts/check-admin-openapi-drift.ts",
    "generate:client": "tsx scripts/generate-admin-client.ts",
    "codegen": "pnpm run emit:openapi && pnpm run generate:client"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.0",
    "zod-openapi": "^6.0.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0"
  }
}
