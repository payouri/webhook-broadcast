{
  "name": "@webhook-broadcast/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:server": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsdown",
    "start:server": "node dist/server.mjs",
    "start:worker": "node dist/worker.mjs",
    "start:migrate": "node dist/migrate.mjs"
  },
  "dependencies": {
    "@koa/bodyparser": "^6.0.0",
    "@koa/router": "^15.0.0",
    "@webhook-broadcast/contract": "workspace:*",
    "@webhook-broadcast/db": "workspace:*",
    "bullmq": "^6.0.0",
    "drizzle-orm": ">=0.45.0 <1.0.0",
    "ioredis": "^6.0.0",
    "koa": "^3.0.0",
    "pg": "^8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/koa": "^3.0.0",
    "@types/pg": "^8.0.0",
    "tsdown": ">=0.20.0 <1.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0"
  }
}
