# A template, not a plain conf: the entrypoint renders it at start-up, so
# ${WEB_PORT} and ${API_UPSTREAM} are settable from the outside. Only those two
# are substituted; nginx's own runtime variables ($host, $http_accept, ...) reach
# the rendered config intact. See apps/web/Dockerfile for the mechanism and the
# values' constraints.
server {
    # Defaults to 8080, not 80: the unprivileged image's master process is not
    # root and cannot bind a privileged port. Settable so that web can move off
    # 8080 where it has to share a network namespace with the api.
    listen ${WEB_PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Container-local liveness probe — answers without touching the SPA
    # bundle or the api upstream.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Same-origin proxy to the api service (`api:8080` on the compose network;
    # `127.0.0.1:<port>` when web and api share one task's namespace) so the
    # dashboard's HttpOnly session cookie (ADR 0005) is same-site. Inherited by
    # every proxying location below.
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # `POST /ingest/:slug` — the producer-facing path, proxied here (issue #47)
    # because the dashboard now displays each Channel's full ingest URL built
    # from this origin (`apps/web/src/lib/ingestUrl.ts`), so that URL must
    # actually resolve here and not only at the api service's own host/port.
    #
    # Deliberately its own location, ahead of the admin block: /ingest is not a
    # client-side route, so it must never fall back to the SPA shell. A
    # producer that advertises `Accept: text/html` has to get its 202 (or its
    # 401/404) from the api — answering it with a 200 HTML page would swallow
    # the Broadcast silently, which is the one failure this product cannot have.
    location ~ ^/ingest(/|$) {
        proxy_pass ${API_UPSTREAM};
    }

    # `/health` and `/ready` — the api's operational endpoints, proxied here
    # (issue #103) so that monitors do not mistake nginx's SPA shell for the
    # api's actual health. These must never fall back to /index.html, just as
    # /ingest must not — they are machine endpoints, and a monitor advertising
    # `Accept: text/html` must still get the api's answer rather than a page.
    location ~ ^/(health|ready)$ {
        access_log off;
        proxy_pass ${API_UPSTREAM};
    }

    # The admin API — the whole of it, `/operator-tokens` included. That one is
    # not a path the SPA ever calls, but it is a tagged path space in the
    # published contract and the endpoint `.env.example` tells operators to
    # POST to, so leaving it out of this regex meant a same-origin operator
    # request got the SPA shell instead of the api.
    #
    # Part of this path space overlaps the client-side router (issue #42: a
    # Channel's own URL is /channels/:id, with /:tab and /:broadcastId beyond
    # it) — a hard reload on one of those URLs is a browser navigation, not an
    # API call, and must get the SPA shell rather than a JSON 404 from the admin
    # API. Browser navigations always send `Accept: text/html…`; this app's own
    # fetch calls never do, so branch on that instead of the path.
    location ~ ^/(auth|channels|broadcasts|deliveries|operator-tokens)(/|$) {
        if ($http_accept ~* "text/html") {
            return 418;
        }
        error_page 418 = /index.html;

        proxy_pass ${API_UPSTREAM};
    }

    # `/docs`, `/docs/scalar.js` and the two OpenAPI representations (issue
    # #109) — proxied here so the admin contract renders in a browser on the
    # dashboard origin: the only credential a plain browser page can present
    # is this origin's HttpOnly session cookie (ADR 0005), and hitting the
    # api's own port directly is a different origin that never receives it.
    #
    # No `Accept: text/html` bypass, unlike the admin API block above and
    # unlike /ingest for the same reason: a browser navigating to /docs sends
    # exactly that header, and it is precisely the request that must reach
    # the api's renderer rather than fall back to the SPA shell.
    location ~ ^/docs(/|$) {
        proxy_pass ${API_UPSTREAM};
    }

    location = /openapi.json {
        proxy_pass ${API_UPSTREAM};
    }

    location = /openapi.yaml {
        proxy_pass ${API_UPSTREAM};
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
