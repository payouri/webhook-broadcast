# Copy to `.env` for local host-side `pnpm run dev:*`.
# DATABASE_URL / REDIS_URL use localhost; compose overrides them to service
# DNS for migrate/api/worker (see docker-compose.yml).
# Default host ports 5433/6380 avoid collisions with other local DBs.
# Full env surface: docs/adr/0008-process-topology-deploy.md
# The web container's two vars (WEB_PORT, API_UPSTREAM) are not listed here:
# nothing host-side reads them, and compose sets WEB_PORT inline at the image
# default rather than from here. They are in ADR 0008's second table.

# --- Required (Zod-validated at boot; process exits if missing/invalid) ---
DATABASE_URL=postgres://webhook_broadcast:webhook_broadcast@localhost:5433/webhook_broadcast
REDIS_URL=redis://localhost:6380
OPERATOR_API_KEY=change-me-dev-only
# Bootstrap credential only. Mint additional revocable operator credentials
# via `POST /operator-tokens` once the API is up (issue #41) — each is
# independently revocable and bearer-only (no dashboard login).

# --- Optional (defaults shown) ---
# Deployment mode. The only thing this service reads it for is whether the
# operator session cookie is marked `Secure` — so a production deployment
# that leaves this at the default serves a cookie usable over plain HTTP.
# The api Dockerfile sets it to `production` for the image.
NODE_ENV=development
# DATABASE_URL's TLS: this local URL carries none — Postgres speaks plain
# TCP on the compose network. Against a managed provider (RDS, Cloud SQL,
# ...) pick one of:
#   - encrypt-only, no cert verification:
#     DATABASE_URL=...?sslmode=require&uselibpqcompat=true
#   - encrypt + verify the server cert against a pinned CA (recommended):
#     DATABASE_URL carries no ssl* parameter at all, and
#     DATABASE_CA_CERT=<the provider's CA bundle, PEM>
#     (setting both is refused at boot — pg would discard the pinned CA)
# Do NOT rely on bare `?sslmode=require` (no uselibpqcompat, no
# DATABASE_CA_CERT): pg-connection-string@2.x treats it as `verify-full`
# against Node's bundled trust store, which a managed provider's own CA
# is generally not in — see packages/db/src/ssl.ts.
# DATABASE_CA_CERT=
# REDIS_URL's TLS: this local URL is redis:// (plaintext) — Redis speaks
# plain TCP on the compose network too. Against a managed provider, use
# rediss:// and, optionally:
#   REDIS_CA_CERT=<the provider's CA bundle, PEM>
# rediss:// with no REDIS_CA_CERT still encrypts, but does not verify the
# server certificate — ioredis otherwise defers to Node's tls.connect
# defaults (rejectUnauthorized: true), which fails against a provider CA
# that generally isn't in Node's bundled trust store, and unlike
# DATABASE_URL there is no ssl* query param to configure this from the URL
# at all. See apps/api/src/redisTls.ts. The scheme alone decides: a
# redis:// URL stays plaintext and REDIS_CA_CERT is ignored.
# REDIS_CA_CERT=
PORT=8080
WORKER_HEALTH_PORT=9091
WORKER_CONCURRENCY=10
INGEST_MAX_BODY_BYTES=1048576
INGEST_HEADER_ALLOWLIST=
INGEST_HEADER_DENYLIST=
# Status POST /ingest/:slug answers when it accepts a Broadcast. 202 is the
# correct REST answer; raise it to 200 only for a producer that retries
# anything else (issue #99). Must be 2xx. Per-Channel override:
# channel.ingestSuccessStatus on the admin API.
INGEST_SUCCESS_STATUS=202
HISTORY_RETENTION_DAYS=30
DELIVERY_TIMEOUT_MS=10000
DELIVERY_MAX_ATTEMPTS=8
DELIVERY_BACKOFF_MS=5000
DELIVERY_BACKOFF_MAX_MS=3600000
ENDPOINT_AUTO_DISABLE_AFTER_MS=3600000
COOKIE_NAME=wb_operator
# When true, the session cookie's Secure flag follows X-Forwarded-Proto.
# Leave false unless a proxy in front of the API sets that header itself.
TRUST_PROXY=false
# Failed POST /auth/login attempts per client before lockout, and the rolling
# window that count applies over (which is also the lockout duration).
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# --- compose Postgres image seed; must match DATABASE_URL credentials ---
POSTGRES_USER=webhook_broadcast
POSTGRES_PASSWORD=webhook_broadcast
POSTGRES_DB=webhook_broadcast

# --- compose host-side port mappings (read by docker-compose.yml only) ---
# Not boot-validated: compose substitutes these into its `ports:` entries, so
# they never reach a Zod schema. Defaults shown; every mapping is bound to
# 127.0.0.1. 5433/6380 avoid collisions with a local Postgres/Redis.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
API_HOST_PORT=8080
WORKER_HOST_PORT=9091
WEB_HOST_PORT=5173
