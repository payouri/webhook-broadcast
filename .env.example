# Copy to .env for local `docker compose up`. See docs/adr/0008-process-topology-deploy.md
# for the full env surface and defaults.

# --- Required (Zod-validated at boot; process exits if missing/invalid) ---
DATABASE_URL=postgres://webhook_broadcast:webhook_broadcast@postgres:5432/webhook_broadcast
REDIS_URL=redis://redis:6379
OPERATOR_API_KEY=change-me-dev-only

# --- Optional (defaults shown) ---
PORT=8080
WORKER_HEALTH_PORT=9091
WORKER_CONCURRENCY=10
INGEST_MAX_BODY_BYTES=1048576
INGEST_HEADER_ALLOWLIST=
INGEST_HEADER_DENYLIST=
HISTORY_RETENTION_DAYS=30
DELIVERY_TIMEOUT_MS=10000
DELIVERY_MAX_ATTEMPTS=8
DELIVERY_BACKOFF_MS=5000
DELIVERY_BACKOFF_MAX_MS=3600000
ENDPOINT_AUTO_DISABLE_AFTER_MS=3600000
COOKIE_NAME=wb_operator

# --- compose-only: seeds the Postgres image, must match DATABASE_URL above ---
POSTGRES_USER=webhook_broadcast
POSTGRES_PASSWORD=webhook_broadcast
POSTGRES_DB=webhook_broadcast
