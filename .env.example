# Copy to `.env` for local host-side `pnpm run dev:*`.
# DATABASE_URL / REDIS_URL use localhost; compose overrides them to service
# DNS for migrate/api/worker (see docker-compose.yml).
# Default host ports 5433/6380 avoid collisions with other local DBs.
# Full env surface: docs/adr/0008-process-topology-deploy.md

# --- Required (Zod-validated at boot; process exits if missing/invalid) ---
DATABASE_URL=postgres://webhook_broadcast:webhook_broadcast@localhost:5433/webhook_broadcast
REDIS_URL=redis://localhost:6380
OPERATOR_API_KEY=change-me-dev-only
# Bootstrap credential only. Mint additional revocable operator credentials
# via `POST /operator-tokens` once the API is up (issue #41) — each is
# independently revocable and bearer-only (no dashboard login).

# --- Optional (defaults shown) ---
PORT=8080
WORKER_HEALTH_PORT=9091
WORKER_CONCURRENCY=10
INGEST_MAX_BODY_BYTES=1048576
INGEST_HEADER_ALLOWLIST=
INGEST_HEADER_DENYLIST=
# Status POST /ingest/:slug answers when it accepts a Broadcast. 202 is the
# correct REST answer; raise it to 200 only for a producer that retries
# anything else (issue #99). Must be 2xx. Per-Channel override:
# channel.ingestSuccessStatus on the admin API.
INGEST_SUCCESS_STATUS=202
HISTORY_RETENTION_DAYS=30
DELIVERY_TIMEOUT_MS=10000
DELIVERY_MAX_ATTEMPTS=8
DELIVERY_BACKOFF_MS=5000
DELIVERY_BACKOFF_MAX_MS=3600000
ENDPOINT_AUTO_DISABLE_AFTER_MS=3600000
COOKIE_NAME=wb_operator
TRUST_PROXY=false
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# --- compose Postgres image seed; must match DATABASE_URL credentials ---
POSTGRES_USER=webhook_broadcast
POSTGRES_PASSWORD=webhook_broadcast
POSTGRES_DB=webhook_broadcast
