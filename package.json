{
  "name": "webhook-broadcast",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:check-projects": "tsx scripts/check-test-projects.ts",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "contract:emit": "pnpm --filter @webhook-broadcast/contract run emit:openapi",
    "contract:check": "pnpm --filter @webhook-broadcast/contract run check:openapi",
    "contract:generate-client": "pnpm --filter @webhook-broadcast/contract run generate:client",
    "contract:codegen": "pnpm --filter @webhook-broadcast/contract run codegen",
    "docs:check": "pnpm run docs:check:env && pnpm run docs:check:tokens",
    "docs:check:env": "tsx scripts/check-env-surface.ts",
    "docs:check:tokens": "tsx scripts/check-design-tokens.ts",
    "dev": "pnpm run migrate && concurrently -n api,worker,web -c blue,magenta,green \"pnpm run dev:api\" \"pnpm run dev:worker\" \"pnpm run dev:web\"",
    "dev:api": "pnpm --filter @webhook-broadcast/api run dev:server",
    "dev:worker": "pnpm --filter @webhook-broadcast/api run dev:worker",
    "dev:web": "pnpm --filter @webhook-broadcast/web run dev",
    "migrate": "tsx --env-file-if-exists=.env apps/api/src/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env apps/api/src/seed.ts",
    "db:generate": "pnpm --filter @webhook-broadcast/db run db:generate"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "concurrently": "^9.2.4",
    "oxlint": "^1.77.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
